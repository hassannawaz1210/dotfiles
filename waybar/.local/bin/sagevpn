#!/usr/bin/env bash
# sageteck VPN: up|down|status|toggle
set -euo pipefail

readonly SERVICE="openvpn-client@sageteck.service"
readonly SYSTEMCTL="/usr/bin/systemctl"
readonly SUDO="/usr/bin/sudo"

is_up() {
  "$SYSTEMCTL" is-active --quiet "$SERVICE"
}

case "${1:-}" in
  up)
    if is_up; then
      echo "already connected"
    else
      "$SUDO" -n "$SYSTEMCTL" start "$SERVICE"
      echo "connected"
    fi
    ;;
  down)
    if is_up; then
      "$SUDO" -n "$SYSTEMCTL" stop "$SERVICE"
      echo "disconnected"
    else
      echo "already disconnected"
    fi
    ;;
  status)
    if is_up; then
      echo "connected"
    else
      echo "disconnected"
    fi
    ;;
  toggle)
    if is_up; then
      "$0" down
    else
      "$0" up
    fi
    ;;
  *)
    echo "usage: sagevpn up|down|status|toggle" >&2
    exit 2
    ;;
esac
