#!/usr/bin/python3
"""Toggle Niri mouse/touchpad scroll speed; Niri reloads the config live."""

import fcntl
import os
from pathlib import Path
import re
import subprocess
import tempfile


def main():
    config = Path.home() / ".config/niri/config.kdl"
    pattern = r"(scroll-factor )(1\.0|5\.0)( // managed by scroll-speed-toggle)"
    with config.with_name(".scroll-speed.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        original = config.read_text()
        matches = re.findall(pattern, original)
        if len(matches) != 2 or matches[0][1] != matches[1][1]:
            raise RuntimeError("Expected matching mouse and touchpad scroll-speed settings")
        speed = "5.0" if matches[0][1] == "1.0" else "1.0"
        updated = re.sub(pattern, lambda m: m[1] + speed + m[3], original)
        with tempfile.NamedTemporaryFile(mode="w", dir=config.parent, suffix=".kdl", delete=False) as candidate:
            candidate.write(updated)
            candidate_path = Path(candidate.name)
        try:
            subprocess.run(
                ["niri", "validate", "--config", str(candidate_path)],
                check=True, capture_output=True, text=True,
            )
            if config.read_text() != original:
                raise RuntimeError("Niri config changed concurrently; try again")
            candidate_path.chmod(config.stat().st_mode & 0o777)
            os.replace(candidate_path, config)
        finally:
            candidate_path.unlink(missing_ok=True)
    label = "Fast scrolling: 5×" if speed == "5.0" else "Normal scrolling"
    print(label)
    subprocess.run(
        ["notify-send", "-a", "Scroll speed", "-t", "1800", label,
         "Super + S toggles scrolling speed"],
        check=False,
    )


if __name__ == "__main__":
    main()
