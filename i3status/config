# i3status configuration file.
general {
        output_format  = "i3bar"
        colors = true
        color_good     = "#a9dc76"
        color_degraded = "#ffd866"
        color_bad      = "#ff6188"
        interval = 1
}

order += "volume master"
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "disk /"
order += "memory"
order += "load"
order += "tztime local"

wireless _first_ {
        format_up   = " %essid %ip"
        format_down = " down"
}

ethernet _first_ {
        format_up   = " %ip (%speed)"
        format_down = " down"
}

battery all {
        format          = "%status %percentage %remaining"
        format_down     = " no battery"
        status_chr      = " CHR"
        status_bat      = " BAT"
        status_unk      = " UNK"
        status_full     = " FULL"
        low_threshold   = 15
        threshold_type  = percentage
}

disk "/" {
        format          = " %avail"
        low_threshold   = 10
        threshold_type  = gbytes_avail
}

memory {
        format          = " %used / %available"
        threshold_degraded = "1G"
        format_degraded = " LOW: %available"
}

load {
        format          = " %1min"
        max_threshold   = 4
}

volume master {
        format          = " %volume"
        format_muted    = " muted (%volume)"
        device          = "default"
        mixer           = "Master"
        mixer_idx       = 0
}

tztime local {
        format = " %a %b %d  %I:%M %p"
}
